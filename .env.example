
# Public build-time configuration only. Do not put API secrets, service-role keys,
# PayPal credentials, or private tokens in this file or any Vite-exposed variable.
# The static landing page does not call Gemini or any private API directly.
# --- Landing page (this site) pricing configuration -----------------------------
# These are Vite build-time vars. The landing site is static; the values are baked
# into the build at `npm run build` time. `build.sh` supplies the deployment base
# path explicitly; unset pricing variables use the canonical fallbacks below.

# INKWELL_PRO_PRICE: Display price for the Inkwell Pro one-time purchase for unlimited projects.
# Example: "$120", "£120", "€120"
INKWELL_PRO_PRICE="$120"

# INKWELL_PRO_CURRENCY: ISO 4217 currency code for the price.
INKWELL_PRO_CURRENCY="USD"

# INKWELL_PRO_PRICE_LABEL: Caption under the price.
INKWELL_PRO_PRICE_LABEL="One-time purchase · unlimited projects"

# INKWELL_ANALYSIS_PRICE: Display price for current-major-version Analysis access.
INKWELL_ANALYSIS_PRICE="$30"

# INKWELL_ANALYSIS_CURRENCY: ISO 4217 currency code for the Analysis price.
INKWELL_ANALYSIS_CURRENCY="USD"

# INKWELL_ANALYSIS_PRICE_LABEL: Caption under the Analysis price.
INKWELL_ANALYSIS_PRICE_LABEL="Current major version · one-time"

# INKWELL_SUBSCRIPTION_PRICE: Display price for the monthly Subscription.
INKWELL_SUBSCRIPTION_PRICE="$5/month"

# INKWELL_SUBSCRIPTION_CURRENCY: ISO 4217 currency code for the monthly price.
INKWELL_SUBSCRIPTION_CURRENCY="USD"

# INKWELL_SUBSCRIPTION_PRICE_LABEL: Caption under the monthly price.
INKWELL_SUBSCRIPTION_PRICE_LABEL="Billed monthly"

# Purchases are currently disabled. Keep this fallback on the pricing section
# until a live checkout is intentionally enabled. When sales open, set this to
# the hosted checkout URL for the Pro CTA.
INKWELL_PAYPAL_CHECKOUT_URL="#pricing"
